# ---------------------------------------------------------------------------
# AgriVision AI - environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` (project root) or `backend/.env` and fill in the
# values for your machine.  NEVER commit a filled-in `.env` file.
#
#   cp .env.example .env
#
# The backend reads `backend/.env` first and falls back to the root `.env`.
# ---------------------------------------------------------------------------

# -- MongoDB Atlas ----------------------------------------------------------
# Connection string from Atlas -> "Connect" -> "Drivers" -> "Node.js".
# Replace <username>, <password>, <cluster-host> with your own values and URL
# encode any special characters in the password (e.g. @ -> %40).
# Leave EMPTY to run the API without a database: the service still boots and
# serves /health and /models/status, while every data route returns HTTP 503.
MONGODB_URI=
MONGODB_DB_NAME=agrivision_ai

# -- JWT signing secret -----------------------------------------------------
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (min 32 characters) when ENVIRONMENT=production.
JWT_SECRET_KEY=

# -- Application URLs -------------------------------------------------------
# Origin of the React dev server - used for the CORS allow-list.
FRONTEND_URL=http://localhost:5173
# Public URL of this API - used for self-referencing links and CORS.
BACKEND_URL=http://localhost:8000

# -- Weather provider -------------------------------------------------------
# Optional. The default provider is Open-Meteo, which needs NO key.
# Leave empty unless you swap WEATHER_API_BASE_URL for a keyed provider.
WEATHER_API_KEY=

# ---------------------------------------------------------------------------
# Optional overrides (sensible defaults are shown - safe to leave as-is)
# ---------------------------------------------------------------------------

# ENVIRONMENT=development
# DEBUG=false
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=7
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# CSRF_ENABLED=true
# ADDITIONAL_CORS_ORIGINS=
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_RATE_LIMIT_REQUESTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# MAX_UPLOAD_BYTES=10485760
# ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
# DEVICE=cpu
# WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
# WEATHER_TIMEOUT_SECONDS=10
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST=65536
# ARGON2_PARALLELISM=2
