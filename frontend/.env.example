# ---------------------------------------------------------------------------
# AgriVision AI - frontend environment template
#
#   cp .env.example .env.local
#
# The Vite dev server proxies /api to the backend (see vite.config.ts), so
# in local development you normally do NOT need to set VITE_API_BASE_URL at
# all - the default of "/api/v1" keeps the browser on the same origin, which
# is what makes the SameSite=Lax session cookie work.
# ---------------------------------------------------------------------------

# Base URL of the API. Leave as the relative default for the dev proxy and
# for a same-origin production deployment.
VITE_API_BASE_URL=/api/v1

# Backend origin used by the Vite dev proxy.
BACKEND_URL=http://localhost:8000
